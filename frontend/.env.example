# Copy to `.env.local`. Read once in src/lib/config.ts, never via process.env elsewhere.

# Base URL of the Express API. Must match the backend's HOST/PORT and be present in
# the backend's CORS_ORIGINS allowlist.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4300

# Build-time only, and only needed for Unlumen UI *Pro* components. Free components
# install from the plain registry URL in components.json with no credential at all, so
# this stays unset by default. On buying a licence, set the key here and swap the
# `@unlumen-ui` entry in components.json to the object form:
#   { "url": "https://ui.unlumen.com/r/{name}.json",
#     "headers": { "Authorization": "Bearer ${UNLUMEN_LICENSE_KEY}" } }
# Never referenced by application code — the CLI reads it, src/lib/config.ts does not.
# UNLUMEN_LICENSE_KEY=
