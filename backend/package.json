{
  "name": "@leviosa/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express API that turns the Docker Engine API into volume insight.",
  "main": "dist/server.js",
  "scripts": {
    "predev": "npm run build --workspace @leviosa/shared",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "prebuild": "npm run build --workspace @leviosa/shared",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dockerode": "^5.0.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
