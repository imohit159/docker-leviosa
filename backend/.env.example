# Copy to `.env` and adjust. Every variable is optional: the defaults below are what
# the application uses when the variable is absent. Parsing and validation live in
# src/config/env.config.ts, which is the only file permitted to read process.env.

# ---------------------------------------------------------------------------- server
NODE_ENV=development
HOST=127.0.0.1
PORT=4300
LOG_LEVEL=info
# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
BODY_LIMIT=64kb
SHUTDOWN_GRACE_MS=10000

# ---------------------------------------------------------------------------- docker
# Local path to the Engine API. Leave this commented out: the default is chosen from
# the host platform, which is what you want on all three.
#   macOS / Linux   /var/run/docker.sock      (unix socket)
#   Windows         //./pipe/docker_engine    (named pipe — Docker Desktop publishes
#                                              no unix socket, so the Linux path here
#                                              fails with `connect ENOENT`)
# Ignored when DOCKER_HOST is set.
# DOCKER_SOCKET_PATH=
#
# Point at a daemon other than the local one. Overrides DOCKER_SOCKET_PATH.
#   remote TCP      tcp://10.0.0.5:2375
#   rootless        unix:///run/user/1000/docker.sock
#   Windows pipe    npipe:////./pipe/docker_engine
# DOCKER_HOST=
DOCKER_TIMEOUT_MS=30000
# Volume and container listings are reused for this long to keep a polling dashboard
# from turning into a burst of daemon calls.
INVENTORY_CACHE_MS=3000

# --------------------------------------------------------------------------- scanning
# Image used for the throwaway measurement container. Needs a POSIX shell plus
# du, find and stat, which any Alpine or BusyBox image provides.
SCANNER_IMAGE=alpine:3.22
SCANNER_AUTO_PULL=true
# Budget for a single measurement. Multi-terabyte volumes need more than the default.
SCAN_TIMEOUT_MS=300000
# Simultaneous measurement containers. Scans are disk-bound on the daemon, so raising
# this makes every scan slower rather than finishing sooner.
SCAN_CONCURRENCY=2
SCAN_QUEUE_LIMIT=200
# A measurement older than this is still shown, but labelled STALE.
SCAN_CACHE_TTL_MS=21600000
# Second traversal that finds the newest mtime inside a volume. Roughly doubles scan
# cost; disable it on very large volumes if scans start timing out.
SCAN_WITH_LAST_WRITE=true
# Read the volume mountpoint directly when this process can. Only possible on a local
# Linux daemon whose storage root is readable by this user, which usually means root.
SCAN_ALLOW_HOST_FS=true
BROWSE_MAX_ENTRIES=500

# -------------------------------------------------------------------------- persistence
# Holds measurement history, the attachment ledger and the audit trail.
DATABASE_PATH=./data/leviosa.sqlite
HISTORY_RETENTION_DAYS=90

# --------------------------------------------------------------------------- scheduling
# Periodic re-measurement of every volume. This is what fills the growth series;
# with it disabled, history only accumulates from manual scans.
SNAPSHOT_ENABLED=true
SNAPSHOT_CRON=15 3 * * *
# How often we record which containers are attached to which volumes. This ledger is
# the only source of idle-time data, because Docker itself stores none.
SIGHTING_INTERVAL_MS=300000
# Idle-day figures are flagged unreliable until a volume has been observed this long.
SIGHTING_TRUST_AFTER_DAYS=7

# ----------------------------------------------------------------------------- features
# Set to false to run the API strictly read-only.
ALLOW_VOLUME_DELETE=true
